title                   = CHARMM36 interaction-energy rerun

; Required for constructing the TPR, but no dynamics are performed in -rerun
integrator              = md
nsteps                  = 25000000
dt                      = 0.002

; Write energies for every supplied trajectory frame
nstenergy               = 1
nstlog                  = 5000

nstxout                 = 0
nstvout                 = 0
nstfout                 = 0
nstxout-compressed      = 0

; Match production topology treatment
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

; Neighbour searching
cutoff-scheme           = Verlet
nstlist                 = 10
verlet-buffer-tolerance = 0.005

; Electrostatics
coulombtype             = PME
rcoulomb                = 1.2
pme_order               = 4
fourierspacing          = 0.16

; CHARMM36 van der Waals treatment
vdwtype                 = Cut-off
vdw-modifier            = Force-switch
rvdw-switch             = 1.0
rvdw                    = 1.2
DispCorr                = no

pbc                     = xyz

; No dynamics or velocity generation during rerun
tcoupl                  = no
pcoupl                  = no
gen_vel                 = no

; Must exactly match names in the supplied index
energygrps              = XRCC4 IFFO1